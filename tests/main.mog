const path = @import("github.com/moglang/path")
fn assert(condition bool, message str) void { if (!condition) error(message) }

assert(path.normalize("a/./b/../c") == "a/c", "relative normalization")
assert(path.normalize("/a//b/../c") == "/a/c", "absolute normalization")
assert(path.normalize("") == "." && path.normalize("/") == "/", "empty and POSIX root normalization")
assert(path.normalize("/../../a") == "/a", "absolute normalization clamps at root")
assert(path.join("a/b", "../c") == "a/c", "join")
assert(path.join("a/b", "/rooted") == "/rooted", "absolute child replaces base")
assert(path.isAbsolute("/a") && !path.isAbsolute("a"), "POSIX absolute detection")
assert(path.basename("a/b.txt") == "b.txt", "basename")
assert(path.dirname("a/b.txt") == "a", "dirname")
assert(path.dirname("file") == ".", "rootless dirname")
assert(path.dirname("/") == "/" && path.basename("/") == "", "POSIX root names")
assert(path.extension("a/b.txt") == ".txt", "extension")
assert(path.extension(".gitignore") == "", "dotfile extension")
assert(path.relative("a/b", "a/c/d") == "../c/d", "relative path")
assert(path.relative("a/b", "a/b") == ".", "identical relative path")

var backslash str = charFromCode(92)
assert(path.normalize("C:" + backslash + "a" + backslash + ".." + backslash + "b") == "C:/b", "Windows drive normalization")
assert(path.normalize("C:folder" + backslash + "file") == "C:folder/file", "drive-relative normalization")
assert(path.isAbsolute("C:/a") && !path.isAbsolute("C:a"), "Windows absolute detection")
assert(path.normalize("C:/") == "C:/" && path.basename("C:/") == "", "Windows drive root")
assert(path.join("C:/base", "D:/other") == "D:/other", "different drive child replaces base")
assert(path.join("C:", "child") == "C:child", "drive-relative join")
assert(path.dirname("C:/file.txt") == "C:/", "drive root dirname")
assert(path.dirname("C:file.txt") == "C:", "drive-relative dirname")
assert(path.relative("C:/Work/src", "c:/work/test") == "../test", "Windows relative path is ASCII case-insensitive")
assert(path.relative("C:/a", "D:/b") == "D:/b", "different drive relative returns target")

var unc str = backslash + backslash + "server" + backslash + "share"
assert(path.normalize(unc + backslash + "a" + backslash + ".." + backslash + "b") == "//server/share/b", "UNC normalization")
assert(path.normalize(unc + backslash + ".." + backslash + "b") == "//server/share/b", "UNC normalization clamps at share")
assert(path.dirname("//server/share/file") == "//server/share", "UNC share dirname")
assert(path.relative("//SERVER/share/a", "//server/SHARE/b") == "../b", "UNC relative path is ASCII case-insensitive")
assert(path.relative("//one/share/a", "//two/share/b") == "//two/share/b", "different UNC root returns target")
